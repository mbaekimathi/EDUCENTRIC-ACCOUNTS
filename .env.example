# True on your PC; False on cPanel / production
LOCAL=True

SECRET_KEY=replace-with-a-long-random-secret

# --- Local development (LOCAL=True) ---
LOCAL_DEBUG=True
LOCAL_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOCAL_CSRF_TRUSTED_ORIGINS=
LOCAL_SECURE_SSL_REDIRECT=False
LOCAL_USE_PROXY_SSL_HEADER=False
LOCAL_SERVE_MEDIA=True

# Legacy keys still work when LOCAL=True:
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Hosted production (LOCAL=False) ---
HOSTED_DEBUG=False
HOSTED_ALLOWED_HOSTS=accounts.kwetudeliveries.com
HOSTED_CSRF_TRUSTED_ORIGINS=https://accounts.kwetudeliveries.com
HOSTED_SECURE_SSL_REDIRECT=True
HOSTED_USE_PROXY_SSL_HEADER=True
# Keep True until media/.htaccess is confirmed (see checklist).
# When MEDIA_ROOT points at ADMINISTRATION/media, that tree must have .htaccess too.
HOSTED_SERVE_MEDIA=True
HOSTED_DB_NAME=
HOSTED_DB_USER=
HOSTED_DB_PASSWORD=
HOSTED_DB_HOST=localhost

# Leave DB_NAME blank locally to use SQLite. Set all fields for MySQL.
DB_NAME=my-school-system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

DB_CONN_MAX_AGE=0

# Optional — shared cache + Redis sessions when set.
REDIS_URL=

# Optional: shared Administration media (school logos)
# MEDIA_ROOT=/home/user/EDUCENTRIC/ADMINISTRATION/media
# MEDIA_URL=/media/

# --- cPanel capacity (16GB dedicated) ---
# scripts/cpanel_capacity_checklist.txt
# python manage.py load_probe --base-url https://accounts.example.com --users 40
