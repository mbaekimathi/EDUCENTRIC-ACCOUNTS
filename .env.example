# Local development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Production (cPanel subdomain) — copy and fill in on the server:
# DEBUG=False
# SECRET_KEY=generate-a-long-random-secret
# ALLOWED_HOSTS=accounts.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://accounts.yourdomain.com
# SECURE_SSL_REDIRECT=True
# USE_PROXY_SSL_HEADER=True
# SERVE_MEDIA=True
# Optional: point at Administration media so school logos resolve.
# MEDIA_ROOT=/home/user/EDUCENTRIC/ADMINISTRATION/media
# MEDIA_URL=/media/

# Leave DB_NAME blank to use SQLite locally. Set all fields below for MySQL.
DB_NAME=my-school-system
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional. Leave blank on cPanel if Redis is not available.
REDIS_URL=
